{
  "name": "nominee",
  "version": "3.0.0",
  "description": "The pause is where tools break: token minted at execution, bound to the args a human saw, spendable once, sealed in a hash-chained receipt.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agents",
    "authorization",
    "permissions",
    "policy",
    "guardrails",
    "human-in-the-loop",
    "approvals",
    "audit",
    "receipts",
    "auth",
    "oauth",
    "token",
    "identity",
    "delegation",
    "prompt-injection",
    "agent-security"
  ],
  "author": "Bharath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharath31/nominee.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bharath31/nominee#readme",
  "bugs": "https://github.com/bharath31/nominee/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
