{
  "name": "nominee-cli",
  "version": "2.5.0",
  "description": "Try nominee policies, verify receipts, check and generate policy files, report developer activation, and run the local console for live reports and approvals",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./console": {
      "types": "./dist/console-client.d.ts",
      "import": "./dist/console-client.js"
    }
  },
  "bin": {
    "nominee": "./dist/bin.js"
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["nominee", "cli", "ai", "agents", "authorization", "policy", "receipts", "npx"],
  "author": "Bharath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharath31/nominee.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bharath31/nominee#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "nominee": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
