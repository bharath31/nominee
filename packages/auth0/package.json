{
  "name": "nominee-auth0",
  "version": "2.2.0",
  "description": "Auth0 strategy for nominee — Token Vault tokens and CIBA human-in-the-loop approval for AI agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["auth0", "token-vault", "ciba", "ai", "agents", "auth", "token", "nominee"],
  "author": "Bharath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharath31/nominee.git",
    "directory": "packages/auth0"
  },
  "homepage": "https://github.com/bharath31/nominee#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "nominee": "workspace:^"
  },
  "dependencies": {
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "nominee": "workspace:*",
    "nominee-postgres": "workspace:*",
    "pg": "^8.22.0",
    "pg-mem": "^3.0.14",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
