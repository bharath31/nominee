{
  "name": "nominee-mastra",
  "version": "2.3.0",
  "description": "Decision-bound Mastra tools for governed AI agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["mastra", "agents", "tools", "authorization", "nominee"],
  "author": "Bharath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharath31/nominee.git",
    "directory": "packages/mastra"
  },
  "homepage": "https://github.com/bharath31/nominee#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.54.0",
    "nominee": "workspace:^",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.54.0",
    "@types/node": "^22.10.2",
    "nominee": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  }
}
